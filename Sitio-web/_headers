# Caché del navegador para los archivos estáticos de All Pixels
/fuentes/*
  Cache-Control: public, max-age=31536000, immutable

/iconos/*
  Cache-Control: public, max-age=604800

/fotos/*
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

# Datos y páginas: el navegador siempre comprueba si hay versión nueva
/plantillas.js
  Cache-Control: no-cache

/config.js
  Cache-Control: no-cache

/comun.js
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache
